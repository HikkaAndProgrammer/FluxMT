{
    "name": "fluxmt",
    "version-semver": "0.1.0",
    "dependencies": [
        "boost-container",
        "boost-optional",
        "boost-preprocessor",
        "boost-thread",
        "boost-unordered",
        "boost-uuid",
        "cpptrace",
        "frozen"
    ],
    "features": {
        "psql": {
            "description": "fluxmt::psql, PostgreSQL through libpqxx",
            "dependencies": [
                "libpqxx"
            ]
        },
        "redis": {
            "description": "fluxmt::redis, Redis through hiredis",
            "dependencies": [
                "hiredis"
            ]
        },
        "sqlite": {
            "description": "fluxmt::sqlite, SQLite through the C API",
            "dependencies": [
                "sqlite3"
            ]
        },
        "tests": {
            "description": "fluxmt tests",
            "dependencies": [
                "catch2"
            ]
        }
    },
    "builtin-baseline": "d9d4599ab67bd4e3297e5a43c837e04104e280d8"
}
