@PACKAGE_INIT@

include(CMakeFindDependencyMacro)


macro(import_targets type)
    if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/fluxmt-${type}-targets.cmake")
        set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE "fluxmt ${type} libraries were requested but not found")
        set(${CMAKE_FIND_PACKAGE_NAME}_FOUND OFF)
        return()
    endif()

    include("${CMAKE_CURRENT_LIST_DIR}/fluxmt-${type}-targets.cmake")
endmacro()


if(NOT TARGET fluxmt::core)
    find_dependency(erslib CONFIG)

    if(@FLUXMT_BUILD_PSQL@)
        find_dependency(PostgreSQL)
        find_dependency(libpqxx CONFIG)
    endif()

	if(@FLUXMT_BUILD_SQLITE@)
        find_dependency(unofficial-sqlite3 CONFIG)
    endif()

    if(DEFINED FLUXMT_SHARED_LIBS)
        if(FLUXMT_SHARED_LIBS)
            set(type "shared")
        else()
            set(type "static")
        endif()
    elseif(BUILD_SHARED_LIBS AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/fluxmt-shared-targets.cmake")
        set(type "shared")
    elseif(EXISTS "${CMAKE_CURRENT_LIST_DIR}/fluxmt-static-targets.cmake")
        set(type "static")
    else()
        set(type "shared")
    endif()

    import_targets(${type})
endif()


# find_package(fluxmt REQUIRED COMPONENTS psql)
foreach(driver IN ITEMS @FLUXMT_DRIVERS@)
    set(fluxmt_${driver}_FOUND TRUE)
endforeach()

check_required_components(fluxmt)
